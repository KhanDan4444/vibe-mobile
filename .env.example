# Copy to .env and set your backend URL (LAN IP for physical devices).
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# Production / EAS builds: set EXPO_PUBLIC_API_URL in eas.json per profile
# (preview + production). Use HTTPS in production.

# Sentry (optional — leave unset in local dev)
# Create a separate React Native project at https://sentry.io → Client Keys (DSN)
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Optional EAS secret for source-map upload on native builds: SENTRY_AUTH_TOKEN
