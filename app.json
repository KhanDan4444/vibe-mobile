{
  "expo": {
    "name": "Niku",
    "slug": "vibe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "niku",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.niku.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow ንቁ to access photos for member profile pictures."
      }
    },
    "android": {
      "package": "com.niku.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0f161c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#1e293b",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ንቁ to access photos for member profile pictures."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ንቁ to scan member check-in QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#000508",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160,
            "backgroundColor": "#000508"
          }
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "niku-gym-saas",
          "project": "mobile-react-native",
          "note": "Optional: set EAS secret SENTRY_AUTH_TOKEN to upload source maps. Until then SENTRY_DISABLE_AUTO_UPLOAD=true in eas.json."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bae0b923-df8f-411a-9866-063584f73f62"
      }
    },
    "owner": "mmoney1212"
  }
}
